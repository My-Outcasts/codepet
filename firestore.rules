rules_version = '2';

// Codepet Firestore security rules.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// This file is the source of truth for the rules — editing them in the Firebase
// console is overwritten on the next deploy. Keep it in sync with the documents
// the app actually reads/writes (see CloudSyncService + FeatureFeedbackManager).

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User progress: cloud sync under users/{uid} ---
    // Each signed-in user (incl. anonymous auth) may read/write only their own
    // document and anything nested under it. Mirrors "users/{uid}" cloud sync.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- First-experience feedback ---
    // FeatureFeedbackManager.submit() does a create-only addDocument() to the
    // top-level `feedback` collection. Clients may CREATE a feedback doc but can
    // never read, update, or delete one (reads are admin/console-only).
    //
    // Validated on create: a signed-in author, a 1-5 integer rating, and a
    // string feature key. We intentionally do NOT require userId == auth.uid so
    // a guest (anonymous-auth) submission whose client-side userId lags can't be
    // silently rejected — tighten this if feedback spoofing ever matters.
    match /feedback/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.feature is string;
      allow read, update, delete: if false;
    }

    // --- The founder's company ---
    // ⚠️ INFERRED, NOT VERIFIED AGAINST THE DEPLOYED RULES. `CompanyData.swift`
    // reads and writes companies/{uid} straight from the client, so the live
    // project must already allow this — but this file did not, which means the
    // file and the deployment have drifted. Diff against the console before any
    // `firebase deploy --only firestore:rules`: deploying a file that omits this
    // rule locks the app out of its own company document.
    //
    // Note there is deliberately NO `{document=**}` here. A recursive allow would
    // also grant the connector subcollections below, and in this language allows
    // are additive — a nested `if false` does NOT claw back access a parent match
    // already granted. Subcollections must opt in one at a time.
    match /companies/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // --- Connector credentials (sealed OAuth tokens) ---
      // Closed to every client, including the owner. Only the Cloud Functions
      // touch these, and the admin SDK bypasses rules entirely. The token is
      // encrypted at rest, but encryption is the second line: an exfiltrated
      // blob is still offline material for whoever holds it, and the client has
      // no reason to ever hold one. See functions/src/oauth/githubOAuth.ts.
      match /connectors/{provider} {
        allow read, write: if false;
      }

      // --- Connector status (no secrets) ---
      // What the Environment surface renders: connected or not, which scopes,
      // when. Split from the document above precisely so the UI can answer
      // "is GitHub connected?" without the sealed token ever being readable.
      // Written only by the callback function.
      match /connectorStatus/{provider} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // --- Virtual Company runs ---
    // Written only by Cloud Functions (the admin SDK bypasses these rules), so
    // clients are denied write outright. The owning founder may read their own
    // run back — that is what makes a completed run replayable without the
    // client having to cache the whole event stream itself.
    match /company_runs/{runId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // --- Default deny ---
    // Anything not matched above is closed. New collections must opt in here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
