rules_version = '2';

// Codepet Firestore security rules — SHARED project devpet-8f4b1 (iOS app + web app).
// This file MERGES the existing iOS-app rules (users + feedback) with the new web-app
// rules (companies). Firestore is deny-by-default, so anything not matched here is
// blocked for client access — collections used only by Cloud Functions / the Admin SDK
// (dictionary_cache, narratives_cache, usage) don't need rules and are intentionally
// omitted, exactly as before.
//
// ⚠️ This file drifted from the deployment once already: an earlier revision was a
// rewrite rather than an edit, and dropped the membership model and the subcollection
// wildcard below. Deploying it would have locked every founder out of their own
// departments, threads, and library. It has since been restored FROM the live ruleset
// (release cloud.firestore, ruleset 8394fc8b, deployed 2026-07-13) and re-verified.
// Before `firebase deploy --only firestore:rules`, diff against the live ruleset — do
// not assume this file is ahead of it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- Existing (iOS app) ----

    // A user owns their profile doc AND anything nested under it
    // (e.g. users/{uid}/extensions/cursor). The web app also writes users/{uid}.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // App feedback — anyone using the app can submit a valid payload; clients can't
    // read or edit. Restored verbatim from the previous ruleset.
    match /feedback/{docId} {
      allow create: if request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.feature is string;
      allow read, update, delete: if false;
    }

    // ---- New (Codepet web — companies) ----
    // Model: a user owns exactly one company whose id equals their uid (v1). Rules are
    // written for membership so teams work later without a rewrite, but ownership has a
    // get()-free fast path. That fast path is also what lets the sign-up *batch* seed a
    // company + its subcollections in one commit — inside a batch, get() can't see the
    // company doc being created alongside the subdocs.

    // v1 convention: your company id is your uid. No get(), so it holds even during
    // the seeding batch before the company doc is committed.
    function ownsByConvention(companyId) {
      return signedIn() && request.auth.uid == companyId;
    }

    // Team-member check for the future multi-member case (safe outside batched seeds).
    function isMember(companyId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)).data.memberIds;
    }

    // Ownership must never change on an update — no escalating yourself to owner.
    function ownershipUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    match /companies/{companyId} {
      // Creator must own the company by convention and list themselves as a member.
      // ownerId/memberIds are pinned to the caller, so a company can only ever be
      // created for the account that owns it.
      allow create: if signedIn()
        && companyId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if ownsByConvention(companyId) || isMember(companyId);

      // Owner (by convention) may edit company data and manage the member list, but
      // can never reassign ownership. A non-owner member may edit data only — not
      // ownerId and not the member list (no privilege escalation).
      allow update: if (ownsByConvention(companyId) && ownershipUnchanged())
        || (isMember(companyId)
            && ownershipUnchanged()
            && request.resource.data.memberIds == resource.data.memberIds);

      // Only the owner can delete the whole company.
      allow delete: if ownsByConvention(companyId);

      // Departments, library, chat, and any future per-company subcollection — scoped
      // to the company's owner/members. Deny-by-default keeps every other account out.
      // The leading {sub} segment is load-bearing: a v2 recursive wildcard matches ZERO
      // or more segments, so a bare `match /{document=**}` here would also match the
      // company doc itself and blanket-grant write on it — bypassing the strict
      // create/update/delete rules above (e.g. letting a plain member escalate to owner
      // or delete the company). Requiring {sub} keeps this strictly below the doc.
      //
      // The two connector subcollections are carved out IN THIS CONDITION rather than
      // in nested matches of their own. Allows are additive and a nested `if false`
      // cannot claw back access a parent match already granted, so excluding them here
      // is the only thing that actually denies:
      //
      //   connectors/      sealed OAuth tokens. Written and read solely by the Cloud
      //                    Functions via the admin SDK, which bypasses rules. Denied to
      //                    clients for read AND write. Write matters most: the chat
      //                    function sends the DECRYPTED token to whatever `mcpUrl` this
      //                    document names, so a client that could edit that field could
      //                    redirect a live credential to a server of its choosing.
      //
      //   connectorStatus/ no secrets — provider, connected, scope, timestamp. The
      //                    Environment surface reads it to answer "is GitHub
      //                    connected?". Readable by the owner, but write-denied so the
      //                    UI cannot be made to claim a connection that has no token
      //                    behind it. Only the OAuth callback writes it.
      //
      //   engineering/     sealed GitHub token for an engineering run's repo
      //                    (companies/{uid}/engineering/repo — see engRepo.ts's
      //                    `loadRepo`), same shape and same risk as connectors/: written
      //                    and read solely by the Cloud Functions via the admin SDK.
      //                    Denied to clients for read AND write. Write matters most: a
      //                    client that could overwrite `url`/`sealed` here could redirect
      //                    an engineering run at a repo of its choosing, or replace the
      //                    sealed token with one it can decrypt.
      //
      //   engRuns/         one document per engineering run — status, sessionId,
      //                    creditsSpent. READ stays allowed: the app renders run state
      //                    from it. WRITE is denied, and both reasons are money or
      //                    authorization:
      //                      · engWebhook charges max(0, creditsSpent -
      //                        previousCreditsSpent) and takes the baseline from this
      //                        document (engWebhook.ts). A client that could raise
      //                        `creditsSpent` once would compute every later delta to 0
      //                        and never be charged again. Nothing surfaces that — the
      //                        debit silently becomes a no-op.
      //                      · engSendTurn and engStream both read `sessionId` here to
      //                        choose which Managed Agents session to drive. A forged
      //                        document aims those handlers at a session the caller does
      //                        not own.
      //
      //   engBalance/      the founder's spendable engineering credits
      //                    (companies/{uid}/engBalance/current — see engBalance.ts).
      //                    READ allowed, WRITE denied, the same shape connectorStatus
      //                    uses: the founder must be able to see their balance, and
      //                    must not be able to set it. engStartRun turns this number
      //                    into `budget.max_list_cost` on the Managed Agents session,
      //                    so a client that could write it would be choosing its own
      //                    spend cap. It lives here rather than under engineering/
      //                    precisely because engineering/ is read-denied and this value
      //                    is displayed.
      match /{sub}/{document=**} {
        allow read: if (ownsByConvention(companyId) || isMember(companyId))
          && sub != 'connectors'
          && sub != 'engineering';
        allow write: if (ownsByConvention(companyId) || isMember(companyId))
          && sub != 'connectors'
          && sub != 'connectorStatus'
          && sub != 'engineering'
          && sub != 'engRuns'
          && sub != 'engBalance';
      }
    }

    // BYOK secrets — a user's ENCRYPTED Anthropic key. Read/written ONLY by the server via the
    // Admin SDK (which bypasses rules); no client may ever touch it. Explicit deny over the
    // deny-by-default, because this holds a secret and must never be client-reachable.
    match /userSecrets/{userId} {
      allow read, write: if false;
    }
  }
}
