{
  "name": "codepet-functions",
  "version": "0.1.0",
  "description": "Firebase Cloud Functions for CodePet reflection summaries",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "verify:company": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/verify-company-run.ts",
    "try:company": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/try-company-run.ts",
    "token": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/get-id-token.ts",
    "provision:eng": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/provision-eng-agent.ts",
    "verify:eng": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/verify-eng-run.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "seal:repo": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/seal-repo-doc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "private": true
}
